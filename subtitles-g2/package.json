{
  "name": "subtitles-g2",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "SRT subtitles on G2 glasses with microphone-assisted synchronization.",
  "scripts": {
    "dev": "vite --config vite.config.ts --port 5173 --host",
    "dev:sidecar": "node scripts/sidecar.mjs",
    "dev:asr": "node --env-file=.env.asr.local scripts/asr-server.mjs",
    "check": "tsc -p tsconfig.check.json --noEmit --incremental false",
    "build": "tsc -b && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "qr": "evenhub qr",
    "init:evenhub": "evenhub init",
    "pack:evenhub": "evenhub pack app.json ./dist"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.13",
    "@evenrealities/pretext": "^0.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.12",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.4.0",
    "vite": "^5.4.0",
    "ws": "^8.20.0"
  }
}
