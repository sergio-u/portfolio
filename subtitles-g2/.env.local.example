# Sidecar (optional). When "Mic: Sidecar" is selected, the WebView connects
# to this WebSocket URL to stream PCM from the laptop's microphone.
# Run `npm run dev:sidecar` and copy the printed LAN URL here.
# Example: ws://192.168.1.42:5174
VITE_SIDECAR_URL=

# Internal app credential. Normal dev and production builds include this value
# in client JavaScript. Keep .env.local out of Git; no broker is used when set.
VITE_SONIOX_API_KEY=
VITE_SONIOX_MODEL=stt-rt-v5
