# Server-only. Copy to .env.asr.local. Never prefix these secrets with VITE_.
SONIOX_API_KEY=
# Generate with: openssl rand -hex 32
# Enter this separate token in the app's Server access token field.
ASR_CLIENT_TOKEN=
SONIOX_MODEL=stt-rt-v5
ASR_HOST=127.0.0.1
ASR_PORT=5175
# For a separately hosted HTTPS broker, list allowed app origins, comma-separated.
# Leave empty for the same-origin Vite development proxy.
ASR_ALLOWED_ORIGINS=
