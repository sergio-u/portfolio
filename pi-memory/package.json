{
  "name": "pi-memory",
  "version": "0.1.0",
  "description": "Personal memory + planning extension for PI. Markdown-backed, jj sentinel state, smart-routed capture, Dream consolidation.",
  "author": "Sergio Ugalde",
  "license": "MIT",
  "type": "module",
  "files": [
    "src/**/*.ts",
    "*.mjs",
    "agents/",
    "skills/**/*",
    "templates/**/*",
    "README.md",
    "docs/proposal.md",
    "docs/research.md",
    "docs/implementation-plan.md"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/**/*.test.ts"
  },
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "dependencies": {
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.74.0",
    "@earendil-works/pi-ai": "^0.74.0",
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "typebox": "^1.1.24"
  }
}
