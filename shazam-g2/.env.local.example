# Copy this file to .env.local and fill in your AudD API token.
# Leave blank to use AudD's ~300 anonymous trial requests.
# Get a key at https://dashboard.audd.io
VITE_AUDD_TOKEN=

# Last.fm API credentials — required to scrobble recognized songs.
# Create an API account at https://www.last.fm/api/account/create
# Note: VITE_ vars are bundled into the browser. Treat the shared secret
# as semi-public — fine for personal use, not for distribution.
VITE_LASTFM_API_KEY=
VITE_LASTFM_SHARED_SECRET=

# ACRCloud (optional, alternative recognizer to AudD).
# Host is region-specific — copy from your ACRCloud project dashboard.
# Example: identify-eu-west-1.acrcloud.com
VITE_ACRCLOUD_HOST=
VITE_ACRCLOUD_ACCESS_KEY=
VITE_ACRCLOUD_ACCESS_SECRET=

# Sidecar (optional). When "Mic: Sidecar" is selected, the WebView connects
# to this WebSocket URL to stream PCM from the laptop's microphone.
# Run `npm run dev:sidecar` and copy the printed LAN URL here.
# Example: ws://192.168.1.42:5174
VITE_SIDECAR_URL=
