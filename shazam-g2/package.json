{
  "name": "shazam-g2",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Identify songs playing around you and display results on your G2 glasses.",
  "scripts": {
    "dev": "vite --port 5173 --host",
    "dev:sidecar": "node scripts/sidecar.mjs",
    "build": "tsc -b && vite build",
