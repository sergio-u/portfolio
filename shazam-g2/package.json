    "qr": "evenhub qr",
    "init:evenhub": "evenhub init",
    "pack:evenhub": "evenhub pack app.json ./dist"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.10",
    "@evenrealities/pretext": "^0.1.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "even-toolkit": "^1.7.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.2.4",
    "react-router": "^7.0.0",
    "tailwind-merge": "^3.0.0",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.12",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.4.0",
    "vite": "^5.4.0",
    "ws": "^8.20.0"
  }
