#!/usr/bin/env bash
# hermes-update-all: update Hermes Agent (gateway + dashboard) and Hermes WebUI,
# then restart all three systemd user services and health-check them.
# Install: cp to ~/.local/bin/ && chmod +x
#   hermes-update-all            update + restart
#   hermes-update-all --check    only report whether updates are available
#   hermes-update-all --restart  skip updates, just restart + health-check
#   hermes-update-all --reset-webui  hard-reset WebUI to origin if ff impossible
set -euo pipefail
WEBUI_DIR="$HOME/hermes-webui"
SERVICES=(hermes-gateway hermes-dashboard hermes-webui)
MODE=update; RESET_WEBUI=0
for arg in "$@"; do
  case "$arg" in
    --check) MODE=check ;; --restart) MODE=restart ;; --reset-webui) RESET_WEBUI=1 ;;
    -h|--help) sed -n '2,8p' "$0"; exit 0 ;; *) echo "unknown option: $arg" >&2; exit 2 ;;
  esac
done
say() { printf '\n\033[1;36m==> %s\033[0m\n' "$*"; }
die() { printf '\033[1;31mERROR: %s\033[0m\n' "$*" >&2; exit 1; }
webui_branch() { git -C "$WEBUI_DIR" rev-parse --abbrev-ref HEAD; }
if [[ $MODE == check ]]; then
  say "Hermes Agent"; hermes update --check || true
  say "Hermes WebUI"; git -C "$WEBUI_DIR" fetch -q --tags origin; b=$(webui_branch)
  echo "current: $(git -C "$WEBUI_DIR" describe --tags --always HEAD)"
  echo "latest:  $(git -C "$WEBUI_DIR" describe --tags --always "origin/$b")"
  echo "behind:  $(git -C "$WEBUI_DIR" rev-list --count "HEAD..origin/$b") commits"
  exit 0
fi
if [[ $MODE == update ]]; then
  say "Updating Hermes Agent (gateway + dashboard)"
  hermes update --no-gateway-restart || die "hermes update failed; services untouched"
  say "Updating Hermes WebUI"
  [[ -z $(git -C "$WEBUI_DIR" status --porcelain --untracked-files=no) ]] || die "WebUI has local edits"
  git -C "$WEBUI_DIR" fetch --tags origin; b=$(webui_branch)
  before=$(git -C "$WEBUI_DIR" describe --tags --always HEAD)
  if ! git -C "$WEBUI_DIR" merge --ff-only "origin/$b"; then
    [[ $RESET_WEBUI == 1 ]] || die "WebUI can't fast-forward; re-run with --reset-webui (agent already updated, services NOT restarted)"
    git -C "$WEBUI_DIR" reset --hard "origin/$b"
  fi
  echo "WebUI: $before -> $(git -C "$WEBUI_DIR" describe --tags --always HEAD)"
fi
say "Restarting ${SERVICES[*]}"
systemctl --user daemon-reload
systemctl --user restart "${SERVICES[@]}"
say "Health checks"
wait_http() { local name=$1 url=$2 code
  for _ in $(seq 1 30); do
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 "$url" || true)
    [[ $code =~ ^(2|3) ]] && { echo "ok   $name ($url -> $code)"; return 0; }; sleep 2
  done; echo "FAIL $name ($url -> ${code:-no response})"; return 1; }
fail=0
for s in "${SERVICES[@]}"; do
  systemctl --user is-active --quiet "$s" && echo "ok   $s active" || { echo "FAIL $s not active"; fail=1; }
done
wait_http dashboard http://127.0.0.1:9119/ || fail=1
wait_http webui http://127.0.0.1:8787/health || fail=1
[[ $fail == 1 ]] && { echo "journalctl --user -u hermes-gateway -u hermes-dashboard -u hermes-webui -n 50 --no-pager"; exit 1; }
say "All good. Restart open Hermes CLI sessions to load new code."
