[Unit]
Description=Hermes Agent Web Dashboard (localhost only)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart="%h/.hermes/hermes-agent/.hermes/bin/hermes" "dashboard" "--host" "127.0.0.1" "--port" "9119" "--no-open"
WorkingDirectory=%h/.hermes
Environment="PATH=%h/.hermes/hermes-agent/node_modules/.bin:%h/.hermes/tools/node-26.7.0-linux-x64/bin:%h/.hermes/tools/npm-12.0.2-linux-x64/bin:%h/.local/bin:%h/.npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="HERMES_HOME=%h/.hermes"
Restart=always
RestartSec=10
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=default.target
